<?xml version="1.0" ?>
 <odoo>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">estate property offer action</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.propertice</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
                <list editable="bottom"
                      decoration-danger="status in 'refused'"
                      decoration-success="status in 'accepted'">
                    <field name="id"/>
                    <field name="price"/>
                    <field name="property_type_id"/>
                    <field name="status"/>
                    <field name="partner_id"/>
                    <field name="validity" optional="True"/>
                    <field name="date_deadline"/>
                    <field name="create_date"/>
                    <button name="accepted" icon="fa check"  type="object" invisible="status == 'accepted'" />
                    <button name="refused" icon="fa close"  type="object" invisible="status == 'accepted'"/>
            </list>
        </field>
    </record>
    <record id="estate_property_offer_count_action" model="ir.actions.act_window">
        <field name="name">estate property offer count action</field>
        <field name="res_model">estate.property.offer</field>
        <field name="domain">[('property_type_id','=',active_id)]</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>